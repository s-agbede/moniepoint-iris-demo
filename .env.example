# Copy to .env and fill locally. Never commit credentials.
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6387/0

# Jev verifies applicability and screens shared-cache nominations.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_CONFIDENCE=0.5
CACHE_SIMILARITY=0.75

# Answer generation for /chat misses and cache-off calls.
ANSWER_MODEL=gpt-4.1-mini

# Support investigation model
AGENT_MODEL=gpt-6.1-sol

# Optional Iris agent memory (support_observation custom type enabled in store).
AGENT_MEMORY_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=
